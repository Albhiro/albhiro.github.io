# Netlify redirects - URLs bonitas a archivos físicos

/portfolio    /src/pages/portfolio.html    200
/experience   /src/pages/experience.html   200
/skills       /src/pages/skills.html       200
/contact      /src/pages/contact.html      200

# Fallback a index para rutas no encontradas
/*            /index.html                  200

# Headers para seguridad y performance
[[headers]]
  for = "/*"
  [headers.values]
    X-Frame-Options = "DENY"
    X-XSS-Protection = "1; mode=block"
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "strict-origin-when-cross-origin"

[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000"

[[headers]]
  for = "*.css"
  [headers.values]
    Cache-Control = "public, max-age=31536000"

[[headers]]
  for = "*.js"
  [headers.values]
    Cache-Control = "public, max-age=31536000"
