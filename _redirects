# Netlify redirects - URLs bonitas a archivos físicos (ahora en la raíz)

# FLUJO PRINCIPAL: Landing → Home
/             /index.html      200
/home         /home.html        200

# URLs de páginas específicas
/portfolio    /portfolio.html    200
/experience   /experience.html   200
/skills       /skills.html       200
/contact      /contact.html      200

# Fallback a landing para rutas no encontradas
/*            /landing.html      200

# Headers para seguridad y performance
[[headers]]
  for = "/*"
  [headers.values]
    X-Frame-Options = "DENY"
    X-XSS-Protection = "1; mode=block"
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "strict-origin-when-cross-origin"

[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000"

[[headers]]
  for = "*.css"
  [headers.values]
    Cache-Control = "public, max-age=31536000"

[[headers]]
  for = "*.js"
  [headers.values]
    Cache-Control = "public, max-age=31536000"
